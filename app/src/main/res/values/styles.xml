<resources>
    <style name="CombatText"><item name="android:fontFamily">sans-serif-black</item><item name="android:textColor">#FFFFFF</item><item name="android:textStyle">bold</item><item name="android:textSize">13sp</item></style>
    <style name="CombatHud" parent="CombatText"><item name="android:background">@drawable/combat_hud</item><item name="android:paddingHorizontal">10dp</item><item name="android:paddingVertical">3dp</item><item name="android:gravity">center</item><item name="android:textSize">16sp</item></style>
    <style name="CombatUpgradeTitle"><item name="android:fontFamily">sans-serif-black</item><item name="android:textStyle">bold</item><item name="android:textColor">#073968</item><item name="android:textSize">12sp</item><item name="android:includeFontPadding">false</item></style>
    <style name="CombatUpgradeLevel"><item name="android:textColor">#765000</item><item name="android:textSize">11sp</item><item name="android:includeFontPadding">false</item></style>
    <style name="CombatPrice" parent="CombatText"><item name="android:background">@drawable/combat_button_green</item><item name="android:gravity">center</item><item name="android:paddingHorizontal">8dp</item><item name="android:paddingVertical">4dp</item><item name="android:textSize">14sp</item><item name="android:includeFontPadding">false</item></style>
    <style name="CombatButton" parent="Widget.AppCompat.Button"><item name="android:background">@drawable/combat_button_blue</item><item name="backgroundTint">@null</item><item name="android:textColor">#FFFFFF</item><item name="android:textStyle">bold</item><item name="android:textSize">12sp</item><item name="android:textAllCaps">false</item><item name="android:minWidth">0dp</item><item name="android:minHeight">48dp</item><item name="android:paddingHorizontal">8dp</item><item name="android:paddingVertical">4dp</item></style>
    <style name="DefenceText"><item name="android:textColor">@color/white</item><item name="android:textSize">14sp</item></style>
    <style name="DefenceLabel" parent="DefenceText">
        <item name="android:textColor">#80DCD1</item><item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item>
    </style>
</resources>
