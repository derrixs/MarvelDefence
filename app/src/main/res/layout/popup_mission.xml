<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/mission_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true">
 <LinearLayout android:id="@+id/mission_panel" android:layout_width="match_parent" android:layout_height="match_parent"
  android:layout_marginHorizontal="24dp" android:layout_marginVertical="14dp" android:orientation="vertical"
  android:paddingHorizontal="16dp" android:paddingTop="4dp" android:paddingBottom="16dp" android:background="@drawable/mission_panel" android:clickable="true" android:focusable="true">
  <FrameLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/mission_ribbon">
   <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
    android:text="@string/mission_headquarters" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"
    android:shadowColor="#173B62" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="1" android:paddingHorizontal="54dp"/>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/mission_close" android:layout_width="48dp" android:layout_height="48dp"
    android:layout_gravity="end|top" android:layout_marginTop="4dp" android:background="@drawable/mission_badge" app:backgroundTint="@null"
    android:text="@string/mission_close_symbol" android:textColor="#215F97" android:textSize="24sp" android:minWidth="0dp" android:minHeight="0dp"
    android:padding="0dp" android:contentDescription="@string/mission_close"/>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:orientation="horizontal" android:baselineAligned="false">
   <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/mission_section">
    <com.example.marveldefence.ui.BattlefieldView android:id="@+id/mission_preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="@string/mission_city" android:textSize="14sp" android:textColor="#216297" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mission_briefing" android:textColor="#4F7BA2" android:textSize="11sp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.7" android:orientation="vertical" android:padding="8dp" android:background="@drawable/mission_section">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
     <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mission_roster" android:textColor="#216297" android:textSize="14sp" android:textStyle="bold"/>
     <TextView android:id="@+id/team_count" android:layout_width="wrap_content" android:layout_height="26dp" android:paddingHorizontal="10dp" android:gravity="center" android:background="@drawable/mission_badge" android:textColor="#216297" android:textSize="11sp" android:textStyle="bold" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/mission_hero_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:baselineAligned="false">
   <TextView android:layout_width="0dp" android:layout_weight=".65" android:layout_height="match_parent" android:gravity="center" android:layout_marginEnd="8dp" android:background="@drawable/mission_section" android:text="@string/mission_mode" android:textColor="#216297" android:textSize="11sp" android:textStyle="bold"/>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/mission_powers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:background="@drawable/mission_button_yellow" app:backgroundTint="@null" android:text="@string/mission_powers" android:textSize="13sp" android:textStyle="bold" android:textColor="#463614" android:textAllCaps="false" android:paddingHorizontal="6dp"/>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/sync_button" android:layout_width="0dp" android:layout_weight=".95" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:background="@drawable/mission_button_blue" app:backgroundTint="@null" android:text="@string/mission_refresh" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingHorizontal="6dp"/>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/deploy_button" android:layout_width="0dp" android:layout_weight="1.35" android:layout_height="match_parent" android:background="@drawable/mission_button_green" app:backgroundTint="@null" android:text="@string/mission_enter" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingHorizontal="6dp"/>
  </LinearLayout>
  <TextView android:id="@+id/api_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="18dp" android:gravity="center" android:paddingTop="2dp" android:text="@string/catalog_source" android:textColor="#4F7BA2" android:textSize="11sp" android:accessibilityLiveRegion="polite"/>
 </LinearLayout>
</FrameLayout>