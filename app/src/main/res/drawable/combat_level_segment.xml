<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <gradient
                android:startColor="#FFD42E"
                android:endColor="#FFAD00"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="#E49A00"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#C2C6CC"/>
            <stroke
                android:width="1dp"
                android:color="#E3E6EB"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</selector>
