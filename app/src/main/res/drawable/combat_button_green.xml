<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#52667E"/>
            <stroke
                android:width="2dp"
                android:color="#7892A2"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#009818"/>
            <stroke
                android:width="3dp"
                android:color="#91FFA3"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#004415"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="3dp">
                <shape>
                    <gradient
                        android:startColor="#00ED2A"
                        android:endColor="#009818"
                        android:angle="270"/>
                    <stroke
                        android:width="2dp"
                        android:color="#91FFA3"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item
                android:left="4dp"
                android:right="4dp"
                android:top="4dp"
                android:bottom="6dp">
                <shape>
                    <solid android:color="#00000000"/>
                    <stroke
                        android:width="1dp"
                        android:color="#66FFFFFF"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
            <item
                android:height="10dp"
                android:gravity="top"
                android:top="4dp"
                android:left="6dp"
                android:right="6dp">
                <shape>
                    <gradient
                        android:startColor="#60FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
