<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#031B45"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="3dp">
        <shape>
            <gradient
                android:startColor="#0757B0"
                android:endColor="#032A65"
                android:angle="270"/>
            <stroke
                android:width="2dp"
                android:color="#27D4FF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="5dp"
        android:bottom="7dp">
        <shape>
            <gradient
                android:startColor="#0B3674"
                android:endColor="#031B49"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="#3D88CC"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item
        android:height="10dp"
        android:gravity="top"
        android:top="3dp"
        android:left="6dp"
        android:right="6dp">
        <shape>
            <gradient
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</layer-list>
