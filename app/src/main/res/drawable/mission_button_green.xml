<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#CAD7DF"/>
            <stroke
                android:width="2dp"
                android:color="#94ABB9"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#217B3D"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <solid android:color="#27623E"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <solid android:color="#40BE63"/>
                    <stroke
                        android:width="3dp"
                        android:color="#217B3D"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
            <item
                android:left="4dp"
                android:right="4dp"
                android:top="4dp"
                android:bottom="8dp">
                <shape>
                    <solid android:color="#00000000"/>
                    <stroke
                        android:width="1dp"
                        android:color="#81E89A"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
