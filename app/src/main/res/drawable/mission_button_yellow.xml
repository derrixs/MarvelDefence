<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_enabled="false"><shape><solid android:color="#CAD7DF"/><stroke android:width="2dp" android:color="#94ABB9"/><corners android:radius="8dp"/></shape></item>
 <item android:state_pressed="true"><shape><solid android:color="#B7840E"/><corners android:radius="8dp"/></shape></item>
 <item><layer-list>
  <item android:top="4dp"><shape><solid android:color="#826719"/><corners android:radius="9dp"/></shape></item>
  <item android:bottom="4dp"><shape><solid android:color="#FFD43E"/><stroke android:width="3dp" android:color="#B7840E"/><corners android:radius="9dp"/></shape></item>
  <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="8dp"><shape><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#FFE588"/><corners android:radius="5dp"/></shape></item>
 </layer-list></item>
</selector>