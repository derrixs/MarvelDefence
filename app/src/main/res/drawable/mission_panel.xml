<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="7dp">
        <shape>
            <solid android:color="#173B62"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
    <item android:bottom="7dp">
        <shape>
            <solid android:color="#F4F9FF"/>
            <stroke
                android:width="4dp"
                android:color="#2C67A3"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="10dp"
        android:bottom="17dp">
        <shape>
            <solid android:color="#00000000"/>
            <stroke
                android:width="1dp"
                android:color="#B0CDED"
                android:dashWidth="3dp"
                android:dashGap="2dp"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
</layer-list>
