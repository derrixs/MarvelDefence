<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#EDFBEF"/>
            <stroke
                android:width="2dp"
                android:color="#45A867"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#CEE6FB"/>
            <stroke
                android:width="2dp"
                android:color="#6499C9"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#789AB9"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="#FFFFFF"/>
                    <stroke
                        android:width="2dp"
                        android:color="#ABC9E4"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
